rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is a super admin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "webz3321@gmail.com" || 
        request.auth.token.email == "mraazi317@gmail.com"
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /students/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /teachers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /institutions/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /teacher_connections/{connId} {
      allow read, write: if isAuthenticated();
    }

    match /live_classes/{classId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /class_participants/{partId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /attendance/{attId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /private_chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    match /private_messages/{msgId} {
      allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/private_chats/$(resource.data.chatId)).data.participants;
      allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/private_chats/$(request.resource.data.chatId)).data.participants;
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /group_messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /connection_requests/{reqId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId || request.auth.uid == request.resource.data.fromUserId || request.auth.uid == request.resource.data.toUserId);
    }

    match /connections/{connId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.users;
      allow create: if isAuthenticated();
    }

    match /mock_tests/{testId} {
      allow read: if isAuthenticated();
    }

    match /results/{resultId} {
      allow read, write: if isAuthenticated() && resource.data.studentId == request.auth.uid || request.resource.data.studentId == request.auth.uid;
    }

    match /pro_requests/{reqId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /quizzes/{quizId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    match /teacher_exams/{examId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    match /exam_submissions/{subId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /certificates/{certId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    match /pricing_plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /chat_sessions/{sessionId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /chat_messages/{messageId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /attachments/{attachmentId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }
  }
}
